# =============================================================================
# Omie SQL Explorer — environment configuration
# Copy to .env and edit:  cp .env.example .env
# Values here are placeholders. The app REFUSES to start in production with them.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# development | test | production
NODE_ENV=production
# Host interface/port compose publishes the app on. Keep 127.0.0.1 behind a reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=3001
# Public URL users open in the browser. Used for CSRF origin checks and cookies.
# Production requires https://
APP_URL=https://sql.example.com
# Set when running behind Nginx/Caddy: true, a hop count (1) or a list of proxy IPs.
# Leave false when the app is exposed directly.
TRUST_PROXY=1

# --- Database (PostgreSQL) ----------------------------------------------------
# compose.yaml builds DATABASE_URL from POSTGRES_* (use URL-safe characters in the password).
POSTGRES_DB=dbexplorer
POSTGRES_USER=dbexplorer
POSTGRES_PASSWORD=change-me-db-password
# Only for an external database (outside compose):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Sessions & bootstrap admin ----------------------------------------------
# At least 32 random characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime in hours.
SESSION_HOURS=12
# Account lockout after N failed logins, for M minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# The first administrator is created from these ONLY when the database has no users.
# It is never overwritten afterwards (change the password later in the UI).
# Password: 12+ chars with upper, lower, digit and symbol. The placeholder is rejected.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_NAME=Administrador

# --- Omie API -----------------------------------------------------------------
# mock: fictitious in-memory data, no credentials needed (writes stay in memory).
# live: real Omie account (requires OMIE_APP_KEY and OMIE_APP_SECRET).
OMIE_MODE=mock
OMIE_BASE_URL=https://app.omie.com.br/api/v1
# Server-side only. Never exposed to the browser, logs or audit records.
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Timeout for one Omie HTTP call, and for a whole SQL query (all its calls).
OMIE_TIMEOUT_MS=60000
OMIE_QUERY_TIMEOUT_MS=120000

# --- Write protection ---------------------------------------------------------
# Read-only blocks every INSERT/UPDATE/DELETE regardless of the flags below.
OMIE_READ_ONLY=true
OMIE_ALLOW_INSERT=false
OMIE_ALLOW_UPDATE=false
# DELETE runs only on resources whose Omie API supports it (e.g. clientes);
# the others answer OPERATION_NOT_SUPPORTED.
OMIE_ALLOW_DELETE=false
# Seconds a write preview confirmation stays valid (single use).
WRITE_CONFIRMATION_TTL_SECONDS=120

# --- Query limits -------------------------------------------------------------
# A query that would exceed a limit fails with an explicit error (never truncated silently).
OMIE_MAX_ROWS=1000
OMIE_MAX_API_CALLS=100
OMIE_MAX_WRITE_ROWS=50
# Concurrent Omie calls (Omie allows at most 4 simultaneous requests).
OMIE_CONCURRENCY=4
# Omie calls per minute for the whole app (retries included); excess calls wait their turn.
# Keeps heavy queries from exhausting the app_key quota, which Omie punishes with a temporary block.
OMIE_MAX_CALLS_PER_MINUTE=240

# --- AI assistant (optional) ----------------------------------------------------
# disabled | mock | openai | anthropic
# The assistant only suggests SQL; it never executes anything.
AI_PROVIDER=disabled
# When false (default) no query result data is ever sent to the AI provider — only the schema.
AI_SHARE_RESULT_DATA=false
AI_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Logging ------------------------------------------------------------------
# fatal | error | warn | info  (debug/trace are refused in production)
LOG_LEVEL=info
